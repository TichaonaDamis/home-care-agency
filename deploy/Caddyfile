# Caddy obtains and renews the HTTPS certificate automatically.
# Access logs never include request bodies, and Caddy redacts Cookie/Authorization headers by default.
YOUR_DOMAIN {
	encode gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/carehours-access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
